---
// The landing page shell. It sits outside Starlight so it can use the full-bleed Apex layout, so
// it carries its own head: SEO and social tags, structured data, and the pointers agents use
// (llms.txt and a Markdown copy of this page).
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../fonts/font-face.css';
import '../styles/landing.css';

import geistMono from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import switzerMedium from '../fonts/Switzer-Medium.woff2?url';
import switzerRegular from '../fonts/Switzer-Regular.woff2?url';
import { faq, site as meta } from '../landing/content';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(`${base}/`, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${home}#website`,
			url: home,
			name: 'Appduct',
			description: meta.description,
			publisher: { '@id': 'https://callstack.com/#organization' },
		},
		{
			'@type': 'Organization',
			'@id': 'https://callstack.com/#organization',
			name: 'Callstack',
			url: 'https://callstack.com/',
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${home}#software`,
			name: 'Appduct',
			description: meta.description,
			url: home,
			applicationCategory: 'DeveloperApplication',
			operatingSystem: 'macOS, Linux, Windows, iOS, Android, Web',
			license: 'https://opensource.org/licenses/MIT',
			isAccessibleForFree: true,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
			softwareHelp: new URL(`${base}/start/introduction/`, Astro.site).href,
			sameAs: [meta.repo, 'https://www.npmjs.com/package/appduct', 'https://pub.dev/packages/appduct'],
			publisher: { '@id': 'https://callstack.com/#organization' },
		},
		{
			'@type': 'FAQPage',
			mainEntity: faq.map(({ q, a }) => ({
				'@type': 'Question',
				name: q,
				acceptedAnswer: { '@type': 'Answer', text: a },
			})),
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0a0a0a" />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}/site.webmanifest`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Appduct" />
		<meta property="og:locale" content="en" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={meta.ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={meta.ogAlt} />

		<!-- For agents: the docs index and a Markdown copy of this page. -->
		<link rel="alternate" type="text/plain" title="llms.txt" href={`${base}/llms.txt`} />
		<link rel="alternate" type="text/markdown" title="This page as Markdown" href={`${base}/index.md`} />

		<!-- The three faces the first screen uses, so text never waits on the stylesheet. -->
		<link rel="preload" href={switzerMedium} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={switzerRegular} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
	</body>
</html>
