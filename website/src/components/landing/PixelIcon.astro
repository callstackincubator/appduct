---
// 9x9 pixel icons, drawn from the bitmaps below as one path of unit squares, so they stay crisp
// at any multiple of 9px and take their colour from `currentColor`.
const icons = {
	test: [
		'.........',
		'.......##',
		'......##.',
		'.....##..',
		'##..##...',
		'.####....',
		'..##.....',
		'.........',
		'.........',
	],
	agent: [
		'....#....',
		'....#....',
		'...###...',
		'.#######.',
		'...###...',
		'....#....',
		'....#....',
		'.........',
		'.........',
	],
	lock: [
		'..#####..',
		'.##...##.',
		'.#.....#.',
		'#########',
		'#########',
		'####.####',
		'####.####',
		'#########',
		'.........',
	],
	hand: [
		'...#.....',
		'..#.#....',
		'..#.#....',
		'..#.####.',
		'###.#.#.#',
		'#.#.....#',
		'#.......#',
		'.#.....#.',
		'..#####..',
	],
	plug: [
		'..#...#..',
		'..#...#..',
		'#########',
		'#.......#',
		'.#.....#.',
		'..#####..',
		'....#....',
		'....#....',
		'.........',
	],
} as const;

export type IconName = keyof typeof icons;

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const rows = icons[name];
const d = rows.flatMap((row, y) => [...row].map((c, x) => (c === '#' ? `M${x} ${y}h1v1h-1z` : ''))).join('');
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 9 9"
	fill="currentColor"
	shape-rendering="crispEdges"
	aria-hidden="true"
>
	<path d={d} />
</svg>
