---
// The hero, a race: two agents drive the same app to the same checkout screen. On the left
// the agent taps through the UI (sign in, three products, the cart); on the right it calls three
// of the app's tools over MCP and is there in seconds. Two clocks tell you why you'd want it.
import { hero, site } from '../../landing/content';
import CopyCommand from './CopyCommand.astro';
import Dither from './Dither.astro';
import MiniApp from './MiniApp.astro';
import PixelIcon from './PixelIcon.astro';
import Window from './Window.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-top">
		<div class="hero-copy">
			<h1 class="h1" id="hero-title" set:html={hero.title} />
			<p class="lede">{hero.lede}</p>
			<div class="actions">
				<a class="btn" href={`${base}/start/quick-start/`}>Get started <span aria-hidden="true">→</span></a>
				<CopyCommand command={site.install} />
			</div>
		</div>

		<Window title="agent · tools/list" class="hero-tools">
			<p class="tools-app"><i aria-hidden="true"></i>{hero.app}<span>{hero.tools.length} tools</span></p>
			<ul class="tools">
				{
					hero.tools.map(({ name, args, about }) => (
						<li>
							<code>
								{name}
								<span>({args})</span>
							</code>
							<span>{about}</span>
						</li>
					))
				}
			</ul>
		</Window>
	</div>

	<div
		class="viz"
		data-race
		role="img"
		aria-label="Two agents bring the same app to its checkout screen. Tapping through the UI takes about a minute; calling three of the app's tools over MCP takes three seconds."
	>
		<Dither scene="ducts" focus={0.75} />
		<div class="lanes">
			<div class="lane lane--hand">
				<div class="lane-head">
					<PixelIcon name="agent" size={18} />
					<PixelIcon name="hand" size={18} />
					<span class="clock" data-clock-hand>00:00</span>
				</div>
				<MiniApp kind="ios" class="race-device" />
				<div class="strip strip--taps"><span data-taps>0</span> taps</div>
			</div>
			<div class="lane lane--call">
				<div class="lane-head">
					<PixelIcon name="agent" size={18} />
					<PixelIcon name="plug" size={18} />
					<span class="clock" data-clock-call>00:00</span>
				</div>
				<MiniApp kind="ios" class="race-device" />
				<div class="strip strip--term" data-term></div>
			</div>
		</div>
	</div>
</section>

<script>
	// The animation code loads only when the animation first comes near the viewport.
	import { whenNear } from './lazy';

	const root = document.querySelector<HTMLElement>('[data-race]');
	if (root) whenNear(root, () => void import('./race').then((m) => m.default(root)));
</script>

<style>
	.hero-top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 24rem;
		align-items: center;
		gap: var(--pad);
		padding: clamp(2.5rem, 6vw, 5rem) var(--pad);
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}
	.hero-copy .h1 {
		max-width: 15ch;
		/* Pull the capitals up to the padding edge, so the space above them matches the space
		   under the buttons: Switzer's line box sits about 0.18em above its cap height. */
		margin-top: -0.18em;
	}
	.hero-copy .h1 :global(em) {
		font-style: normal;
		color: var(--accent);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		margin-top: 0.75rem;
	}
	.actions :global(.cmd) {
		width: min(100%, 22rem);
		padding-block: 0.25rem;
	}

	/* The app's tools as the agent lists them: what "an MCP server" means here. */
	.hero-tools {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}
	.tools-app {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--line);
		color: var(--text);
	}
	.tools-app i {
		width: 6px;
		height: 6px;
		background: var(--accent);
	}
	.tools-app span {
		margin-inline-start: auto;
		color: var(--faint);
	}
	.tools {
		margin: 0;
		padding: 0.5rem 0;
		list-style: none;
	}
	.tools li {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding: 0.5rem 1rem;
	}
	.tools code {
		font-family: inherit;
		color: var(--accent);
	}
	.tools code span {
		color: var(--code-punc);
	}
	.tools li > span {
		font-family: var(--font-display);
		font-size: 0.875rem;
		color: var(--muted);
	}

	.viz {
		position: relative;
		border-top: 1px solid var(--line);
		overflow: hidden;
	}
	.lanes {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.lane {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding: clamp(1.5rem, 4vw, 3rem) var(--pad);
	}
	.lane + .lane {
		border-left: 1px solid var(--line-strong);
	}
	.lane-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.375rem 0.75rem;
		background: var(--bg);
		border: 1px solid var(--line-strong);
		color: var(--faint);
	}
	.clock {
		font-family: var(--font-mono);
		font-size: 1.5rem;
		letter-spacing: 0.02em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.lane--call .lane-head {
		color: var(--accent);
	}
	.lane--call .clock {
		color: var(--text);
	}
	.lane--call.is-done .lane-head {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--on-accent);
	}
	.lane--call.is-done .clock {
		color: var(--on-accent);
	}
	.lane--hand.is-done .lane-head {
		border-color: var(--text);
	}
	.lane :global(.device) {
		--w: 12.5rem;
	}
	.strip {
		width: min(100%, 24rem);
		min-height: 4.75rem;
		padding: 0.5rem 0.75rem;
		background: var(--bg);
		border: 1px solid var(--line-strong);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1.6;
		color: var(--code-fg);
		overflow-wrap: anywhere;
	}
	.strip--taps {
		display: grid;
		place-items: center;
		color: var(--faint);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.strip--taps span {
		color: var(--text);
		font-size: 1.25rem;
	}
	.strip :global(.p) {
		color: var(--accent);
	}

	@media (max-width: 64rem) {
		/* Narrower than this the window would squeeze the headline; the race below shows the same tools. */
		.hero-top {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero-tools {
			display: none;
		}
	}
	@media (max-width: 40rem) {
		/* On a phone the clocks carry the left lane; the tap count would only crowd it. */
		.strip--taps {
			display: none;
		}
		.lane {
			padding-inline: 0.5rem;
		}
		.lane :global(.device) {
			--w: 9.5rem;
		}
		.clock {
			font-size: 1.125rem;
		}
		.strip {
			font-size: 0.5625rem;
		}
	}
</style>
