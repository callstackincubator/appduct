---
// The landing page. It sits outside Starlight for the full-bleed layout; the copy lives in
// src/landing/content.ts, which also feeds the Markdown copy at /index.md.
import Landing from '../layouts/Landing.astro';
import Footer from '../components/landing/Footer.astro';
import Hero from '../components/landing/Hero.astro';
import Marquee from '../components/landing/Marquee.astro';
import Nav from '../components/landing/Nav.astro';
import Sections from '../components/landing/Sections.astro';
import { site } from '../landing/content';
---

<Landing title={site.title} description={site.description}>
	<Nav />
	<main class="frame">
		<Hero
			title="Your agent stops tapping. <em>It calls your app.</em>"
			lede="Register functions in your app and your agent calls them over MCP. Three calls instead of a minute of tapping."
		/>
		<Marquee />
		<Sections />
	</main>
	<Footer />
</Landing>
