.build/
.swiftpm/

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# The playground's daemon writes sockets, logs, PID files, and audit records here. Its key and
# config are deliberately committed fixtures so the example works without local setup.
playground/.cordierite/*
!playground/.cordierite/key.pem
!playground/.cordierite/config.json

# playground-native's Xcode project is generated by `xcodegen` from project.yml -- see
# playground-native/ios/README.md.
playground-native/ios/*.xcodeproj
playground-native/ios/.swiftpm/
