[
  {
    "name": "suspends on backgrounding and does not reconnect while in the background, even past the backoff cap",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1","token":"claim-token"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"background"},
      {"expect":"suspend"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"advance","ms":31000}
    ]
  },
  {
    "name": "resumes at once on foregrounding, without waiting for backoff",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1","token":"claim-token"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"background"},
      {"expect":"suspend"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"foreground"},
      {"expect":"connect","mode":"resume","sessionId":"session-1","resumeToken":"resume-1"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-2","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"resumed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}}
    ]
  },
  {
    "name": "does not reconnect when backgrounded during a backoff wait, then resumes at once on foregrounding",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1","token":"claim-token"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"background"},
      {"drive":"advance","ms":31000},
      {"drive":"foreground"},
      {"expect":"connect","mode":"resume","sessionId":"session-1","resumeToken":"resume-1"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-2","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"resumed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}}
    ]
  },
  {
    "name": "sends no connect when backgrounded during a backoff wait, even after the delay passes",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1","token":"claim-token"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"background"},
      {"drive":"advance","ms":31000}
    ]
  },
  {
    "name": "cancels a call in flight with session_suspended when backgrounded",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"registerTool","descriptor":{"name":"slow","description":"Waits for the app."}},
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1","token":"claim-token"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":120}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[{"name":"slow","description":"Waits for the app."}]}},
      {"drive":"receive","frame":{"type":"tool_call","session_id":"session-1","id":"call-1","name":"slow","args":{}}},
      {"expect":"call","name":"slow","args":{}},
      {"drive":"background"},
      {"expect":"suspend"},
      {"expect":"state","state":"reconnecting"},
      {"expect":"cancel","call":"call-1","reason":"session_suspended"}
    ]
  }
]
