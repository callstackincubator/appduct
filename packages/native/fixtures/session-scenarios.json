  {
    "name": "answers tool_timeout and cancels the call when it outlasts its timeout_ms",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"registerTool","descriptor":{"name":"slow","description":"Waits for the app.","timeout_ms":5000}},
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1","token":"claim-token"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[{"name":"slow","description":"Waits for the app.","timeout_ms":5000}]}},
      {"drive":"receive","frame":{"type":"tool_call","session_id":"session-1","id":"call-1","name":"slow","args":{}}},
      {"expect":"call","name":"slow","args":{}},
      {"drive":"advance","ms":5000},
      {"expect":"send","frame":{"type":"tool_error","session_id":"session-1","id":"call-1","error":{"type":"tool_timeout","message":"Tool \"slow\" did not respond within 5000ms."}}},
      {"expect":"cancel","call":"call-1","reason":"timeout"}
    ]
  },
  {
