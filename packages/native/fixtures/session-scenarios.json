[
  {
    "name": "resumes with the rotated token after a drop",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"advance","ms":250},
      {"expect":"connect","mode":"resume","sessionId":"session-1","resumeToken":"resume-1"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-2","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"resumed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"advance","ms":250},
      {"expect":"connect","mode":"resume","sessionId":"session-1","resumeToken":"resume-2"}
    ]
  },
  {
    "name": "does not resume before the jittered backoff delay",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"advance","ms":249},
      {"drive":"disconnect"},
      {"expect":"state","state":"closed","reason":"closed_by_app"},
      {"expect":"session","type":"lost","reason":"closed_by_app"}
    ]
  },
  {
    "name": "reports the session lost when the grace window runs out",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"advance","ms":250},
      {"expect":"connect","mode":"resume","sessionId":"session-1","resumeToken":"resume-1"},
      {"drive":"advance","ms":9750},
      {"expect":"state","state":"closed","reason":"grace_expired"},
      {"expect":"session","type":"lost","reason":"grace_expired"}
    ]
  },
  {
    "name": "never reconnects after a terminal 1008 close, even past the backoff cap",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"close","code":1008,"reason":"policy_violation"},
      {"expect":"state","state":"closed","reason":"policy_violation"},
      {"expect":"session","type":"lost","reason":"policy_violation"},
      {"drive":"advance","ms":31000}
    ]
  },
  {
    "name": "never retries a resume the daemon refuses with 1008",
    "startMs": 1700000000000,
    "random": 0.5,
    "steps": [
      {"drive":"connect","sessionId":"session-1","token":"claim-token","expiresAt":1700000300},
      {"expect":"connect","mode":"claim","sessionId":"session-1"},
      {"expect":"state","state":"connecting"},
      {"drive":"receive","frame":{"type":"session_ack","session_id":"session-1","status":"ok","alias":"phone","resume_token":"resume-1","keepalive_interval_s":15,"grace_s":10}},
      {"expect":"state","state":"active"},
      {"expect":"session","type":"claimed"},
      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[]}},
      {"drive":"drop"},
      {"expect":"state","state":"reconnecting"},
      {"drive":"advance","ms":250},
      {"expect":"connect","mode":"resume","sessionId":"session-1","resumeToken":"resume-1"},
      {"drive":"close","code":1008,"reason":"invalid_resume_token"},
      {"expect":"state","state":"closed","reason":"invalid_resume_token"},
      {"expect":"session","type":"lost","reason":"invalid_resume_token"},
      {"drive":"advance","ms":31000}
    ]
  },
  {
    "name": "reports rejected_by_daemon when a refused resume gives no reason",
