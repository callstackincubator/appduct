      {"expect":"send","frame":{"type":"tool_registry_snapshot","session_id":"session-1","tools":[{"name":"slow","description":"Waits for the app.","timeout_ms":5000}]}},
      {"drive":"receive","frame":{"type":"tool_call","session_id":"session-1","id":"call-1","name":"slow","args":{}}},
      {"expect":"call","name":"slow","args":{}},
      {"drive":"advance","ms":2000},
      {"drive":"receive","frame":{"type":"tool_cancel","session_id":"session-1","id":"call-1","reason":"client_cancelled"}},
      {"expect":"send","frame":{"type":"tool_error","session_id":"session-1","id":"call-1","error":{"type":"tool_cancelled","message":"Tool \"slow\" was cancelled."}}},
      {"expect":"cancel","call":"call-1","reason":"client_cancelled"},
      {"drive":"advance","ms":10000}
    ]
  },
