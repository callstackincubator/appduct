{
  "name": "@appduct/shared",
  "version": "0.12.0",
  "description": "Shared library for Appduct.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "appduct",
    "react-native"
  ],
  "repository": "https://github.com/callstackincubator/appduct",
  "bugs": {
    "url": "https://github.com/callstackincubator/appduct/issues"
  },
  "author": "Szymon Chmal <szymon@chmal.it> (V3RON)",
  "license": "MIT",
  "homepage": "https://github.com/callstackincubator/appduct/tree/main/packages/shared#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run --config ../../vitest.config.ts src/__tests__",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "~5.9.2"
  },
  "files": [
    "dist"
  ]
}
