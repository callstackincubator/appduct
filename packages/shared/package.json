{
  "name": "@appduct/shared",
  "version": "0.14.0",
  "description": "Shared library for Appduct.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "appduct",
    "react-native"
  ],
  "repository": "https://github.com/callstackincubator/appduct",
  "bugs": {
    "url": "https://github.com/callstackincubator/appduct/issues"
  },
  "author": "Szymon Chmal <szymon@chmal.it> (V3RON)",
  "license": "MIT",
  "homepage": "https://github.com/callstackincubator/appduct/tree/main/packages/shared#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run --config ../../vitest.config.ts src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "esbuild": "^0.25.12",
    "react": "19.1.0",
    "typescript": "~5.9.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zod4": "npm:zod@^4.4.3"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
