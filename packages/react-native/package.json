{
  "name": "@appduct/react-native",
  "version": "0.12.0",
  "description": "Expo native client for Appduct sessions",
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./auto": {
      "types": "./build/auto.d.ts",
      "react-native": "./build/auto.js",
      "import": "./build/auto.js",
      "default": "./build/auto.js"
    },
    "./noop": {
      "types": "./build/noop.d.ts",
      "react-native": "./build/noop.js",
      "import": "./build/noop.js",
      "default": "./build/noop.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./autolink-env.js": "./autolink-env.js",
    "./metro": {
      "types": "./metro.d.ts",
      "default": "./metro.js"
    }
  },
  "sideEffects": [
    "./build/auto.js"
  ],
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "scripts": {
    "build": "node scripts/sync-native-core.mjs && tsc",
    "clean": "rm -rf build",
    "lint": "eslint .",
    "sync-native-core": "node scripts/sync-native-core.mjs",
    "test": "vitest run --config ../../vitest.config.ts src/__tests__",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepack": "node scripts/sync-native-core.mjs",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "react-native",
    "@appduct/react-native",
    "appduct"
  ],
  "repository": "https://github.com/callstackincubator/appduct",
  "bugs": {
    "url": "https://github.com/callstackincubator/appduct/issues"
  },
  "author": "Szymon Chmal <szymon@chmal.it> (V3RON)",
  "license": "MIT",
  "homepage": "https://github.com/callstackincubator/appduct/tree/main/packages/react-native#readme",
  "codegenConfig": {
    "name": "AppductSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.callstack.appduct"
    }
  },
  "dependencies": {
    "@appduct/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.1",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^15.0.3",
    "expo": "^54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "~5.9.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zod4": "npm:zod@^4.4.3"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
