# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__

/babel.config.js
/android/src/androidTest/
/android/build/
/example/

# ios/Core/, android/core/, and android/core-noop/ are gitignored (build/publish-time output of
# scripts/sync-native-core.mjs, see .gitignore) but deliberately NOT listed here: they must ship in
# the npm tarball since an installed consumer has no packages/native to sync from -- see
# docs/tasks/14-native-core-extraction.md and this package's "build"/"prepack" scripts, which
# regenerate them before packing.
